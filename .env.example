# Konfigurasi pembaca foto & asisten temuan (hanya dibaca di server).
# Salin ke .env.local lalu isi kuncinya. Jangan pernah meng-commit .env.local.

# Penyedia utama: deepseek atau haiku. Bila penyedia utama gagal atau kuncinya kosong,
# server mencoba penyedia satunya sebelum mengarahkan pengguna ke isian manual.
LLM_PROVIDER=deepseek

# DeepSeek (utama, mode non-thinking)
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-flash

# Claude Haiku lewat API Anthropic (pembanding)
LLM_HAIKU_API_KEY=
LLM_HAIKU_BASE_URL=https://api.anthropic.com
LLM_HAIKU_MODEL=claude-haiku-5-5
